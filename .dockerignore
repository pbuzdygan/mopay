# Version control, local agent context and documentation
.git
.gitignore
.dockerignore
.codex
.agents
.ai
.github
docs
AGENTS.md
CLAUDE.md
README*
CHANGELOG.md

# Dependencies are installed inside the image; frontend assets are built there
**/node_modules
**/dist
**/build
**/.npm
**/.cache
**/.vite
**/*.tsbuildinfo
**/*.tgz

# Test sources and generated reports are not runtime/build inputs
**/tests
**/test
**/__tests__
**/e2e
**/*.test.*
**/*.spec.*
**/coverage
**/.nyc_output
**/test-results
**/playwright-report
**/playwright/.cache

# Local environment, credentials and runtime data must not enter build context
**/.env
**/.env.*
**/.aws
**/.ssh
**/*.key
**/*.pem
**/*.p12
**/*.pfx
data
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*

# Logs, temporary files and backups
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/*.pid
**/*.pid.lock
tmp
temp
**/.tmp
**/*.tmp
**/*.temp
**/*.bak
**/*.swp
**/*.swo
**/*~

# Editor, OS and legacy Python cache artifacts
**/.idea
**/.vscode
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
**/*:Zone.Identifier
**/__pycache__
**/*.pyc
**/*.pyo
**/.mypy_cache
**/.pytest_cache
**/.venv
venv
**/.coverage
